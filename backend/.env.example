# Cross-Paradigm Compression Lab — backend configuration
# Copy to .env (same folder or project root) and adjust.

# --- Core ---
APP_NAME="CPC Lab API"
ENV=development                  # development | production | test
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=info

# --- Database (SQLite default for local dev; PostgreSQL in docker-compose) ---
# DATABASE_URL=postgresql+psycopg2://cpc:cpc@localhost:5432/cpc
DATABASE_URL=sqlite:///./data/cpc.db

# --- Auth ---
# CHANGE THESE IN ANY NON-LOCAL ENVIRONMENT
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720
ADMIN_EMAIL=admin@cpc.lab
ADMIN_PASSWORD=change-me-admin

# --- Storage ---
STORAGE_BACKEND=local            # local | s3
DATA_DIR=./data                  # local artifact storage root
# STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=cpc-lab
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# --- Jobs ---
JOB_BACKEND=thread               # thread (in-process, CPU demo jobs) | celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Research engines ---
ENGINE_TORCH=false               # true enables PyTorch/HF engines when installed (requirements-gpu.txt)
HF_OFFLINE=false

# --- Assistant (LLM integration is entirely optional) ---
# All provider credentials come from the environment; nothing is hardcoded.
ASSISTANT_PROVIDER=              # openai | anthropic | openai-compatible | local | (empty = offline mode)
ASSISTANT_BASE_URL=              # e.g. https://api.openai.com/v1 or a local server
ASSISTANT_MODEL=
ASSISTANT_API_KEY_ENV=           # name of the env var that holds the API key, e.g. OPENAI_API_KEY

# --- Scholarly APIs (no keys required; set a contact email for polite pooling) ---
SCHOLAR_CONTACT_EMAIL=
SCHOLAR_RATE_LIMIT_PER_MIN=20

# --- Security ---
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_MAX_MB=25
