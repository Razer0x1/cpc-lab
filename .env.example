# ── CPC Lab root environment (copy to .env and adjust) ──────────────────

# Auth (seeded admin; CHANGE IN PRODUCTION)
ADMIN_EMAIL=admin@cpc.lab
ADMIN_PASSWORD=change-me-admin
JWT_SECRET=change-me-in-production

# Postgres (compose service name resolution applies inside docker network)
POSTGRES_USER=cpc
POSTGRES_PASSWORD=cpcpass
POSTGRES_DB=cpc

# CORS: where the frontend is reachable from the user's browser
CORS_ORIGINS=http://localhost:3000

# Where the user's browser reaches the API (compile-time for the frontend build)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Scholarly search email for polite politeness headers (optional)
SCHOLAR_CONTACT_EMAIL=

# LLM assistant (optional; offline rules mode is used when unset)
# ASSISTANT_API_KEY_ENV=OPENAI_API_KEY
# ASSISTANT_PROVIDER=openai
# ASSISTANT_BASE_URL=https://api.openai.com/v1
# ASSISTANT_MODEL=gpt-4o-mini

# Engine switches (optional GPU extras live in backend/requirements-gpu.txt)
# ENGINE_TORCH=false
